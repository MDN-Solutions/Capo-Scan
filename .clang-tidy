# Static analysis for the C++ code, focused on memory safety and the bugs that
# matter when parsing bytes coming from the car (ELM327, ISO-TP, UDS).
# CI treats every finding as an error.
Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers
WarningsAsErrors: '*'
# Only report problems in our own headers, not in third-party ones.
HeaderFilterRegex: '.*/(core|app|ext-diag|bridge-j2534)/.*'
FormatStyle: file
CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: 25
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: true
  - key: misc-const-correctness.WarnPointersAsValues
    value: false
