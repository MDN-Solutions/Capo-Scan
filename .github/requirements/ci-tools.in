# Python tools used by the CI workflows, installed with hash checking:
#   pip install --require-hashes --no-deps -r .github/requirements/ci-tools.txt
#
# Regenerate after editing. --exclude-newer applies the same 7-day cooldown as
# Dependabot: versions published in the last week are not used yet.
#   uv pip compile --python-version 3.13 --generate-hashes --universal \
#     --exclude-newer "$(date -u -d '7 days ago' +%Y-%m-%dT%H:%M:%SZ)" \
#     .github/requirements/ci-tools.in -o .github/requirements/ci-tools.txt
